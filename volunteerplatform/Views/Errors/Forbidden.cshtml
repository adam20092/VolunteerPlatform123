@{
    ViewData["Title"] = "Access Denied";
}

<div class="container text-center" style="margin-top: 100px; margin-bottom: 100px;">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="display-1 fw-bold text-warning mb-3">403</div>
            <h2 class="fw-bold mb-4">Access Denied</h2>
            <p class="text-muted mb-5 lead">
                You do not have permission to view this page. Please contact your administrator if you believe this is an error.
            </p>
            <div class="d-flex gap-3 justify-content-center">
                <a href="/" class="btn btn-warning btn-lg rounded-pill px-5 shadow-sm text-white">
                    <i class="bi bi-house-door me-2"></i> Back to Home
                </a>
                <a href="/Account/Login" class="btn btn-outline-secondary btn-lg rounded-pill px-5">
                    <i class="bi bi-person me-2"></i> Try Another Account
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }
    .display-1 {
        font-size: 8rem;
        letter-spacing: -2px;
        opacity: 0.8;
    }
</style>

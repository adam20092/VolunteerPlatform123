@{
    ViewData["Title"] = "Error";
    var code = ViewData["ErrorCode"]?.ToString() ?? "500";
}

<div class="container text-center" style="margin-top: 100px; margin-bottom: 100px;">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="display-1 fw-bold text-danger mb-3">@code</div>
            <h2 class="fw-bold mb-4">Something went wrong</h2>
            <p class="text-muted mb-5 lead">
                An unexpected error occurred. Our team has been notified and is working to fix it.
            </p>
            <div class="d-flex gap-3 justify-content-center">
                <a href="/" class="btn btn-danger btn-lg rounded-pill px-5 shadow-sm">
                    <i class="bi bi-house-door me-2"></i> Back to Home
                </a>
                <a href="mailto:support@volunteer.com" class="btn btn-outline-secondary btn-lg rounded-pill px-5">
                    <i class="bi bi-envelope me-2"></i> Contact Support
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }
    .display-1 {
        font-size: 8rem;
        letter-spacing: -2px;
        opacity: 0.8;
    }
</style>
